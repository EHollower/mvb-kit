\newcommand{\mvbkitchapter}[1]{
	\def\@mvbkitdir{\@mvbkitbasedir/#1}
	\input{"\@mvbkitdir/chapter.tex"}
	\def\@mvbkitdir{\@mvbkitbasedir}
}

