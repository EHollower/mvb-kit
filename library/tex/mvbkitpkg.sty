%----------------------------------------------------------------------------------------
%   CUSTOM PAGE HEADER SETUP
%----------------------------------------------------------------------------------------

% --- Header Processing Logic ---

% Uses eTeX marks to track source files across asynchronous page breaks.
% logic is offloaded to Python (via Lua) to handle state and string parsing.
% We capture `\splitbotmark` (or `\botmark`) to determine the page context.

\begin{luacode*}
function fetch_python_header(marks, builddir)
    local cmd = string.format(
        "python3 library/tex/preprocessor.py --print-header '%s' -o %s/header2.tmp",
        marks, builddir
    )
    os.execute(cmd)
    tex.print(string.format("\\input{%s/header2.tmp}", builddir))
end
\end{luacode*}

\newcommand{\updateheader}[1]{%
    \directlua{fetch_python_header("\luaescapestring{#1}", "\luaescapestring{\@builddir}")}%
}

